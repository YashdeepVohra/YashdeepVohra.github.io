# Local secrets — the Firebase web config in js/config/firebase.js is
# NOT a secret and is meant to be committed. This is for anything that
# genuinely is: service-account keys, admin SDK credentials, .env files.
.env
.env.*
serviceAccountKey.json
*-firebase-adminsdk-*.json

