rules_version = '2';

// =====================================================================
// livesociya — Firestore Security Rules
// =====================================================================
//
// The whole point of moving from usernames to UIDs: every rule below
// decides using request.auth.uid, which the server already knows and
// cannot be forged. A username-keyed schema would need a document read
// on every single write just to answer "is this really you?".
//
// Deploy:   firebase deploy --only firestore:rules
// Test:     Firebase console > Firestore > Rules > Rules Playground
//
// Data model
//   users/{uid}                   public profile; followers[] is written
//                                 only by the follower, followRequests[]
//                                 is the queue on a private account
//   users/{uid}/private/{doc}     email etc. — owner only
//   usernames/{handle}            { uid } — handle reservation, create-once
//   events/{eventId}              hostUid, participantUids[], hypedUids[]
//   events/{eventId}/messages/*   event chat, participants only
//   chats/{uidA_uidB}             userUids[2], sorted, id == the join
//   chats/{chatId}/messages/*     direct messages, the two members only
//   orbit/{uidA_uidB}             a connection: pending, then linked
//                                 (follows live as arrays on users/*)
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMe(userId) {
      return signedIn() && uid() == userId;
    }

    // OPTIONAL CAMPUS LOCK ------------------------------------------
    // Replace the domain and swap signedIn() for campusMember() in the
    // read/write rules below to restrict the app to your college.
    // Google sign-in already verifies the email, so this cannot be
    // faked by editing the client.
    function campusMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@yourcollege[.]edu$');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when the only difference between two uid arrays is the
    // caller adding or removing THEMSELVES. This is what stops someone
    // signing other people up for events or faking hype counts.
    function selfToggleOnly(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([uid()])
          && before.toSet().difference(after.toSet()).hasOnly([uid()]);
    }

    // What a write adds to / removes from a list, as sets.
    function added(before, after) {
      return after.toSet().difference(before.toSet());
    }
    function removed(before, after) {
      return before.toSet().difference(after.toSet());
    }

    function listOr(data, key) {
      return key in data ? data[key] : [];
    }

    // A list may gain or lose at most one entry per write. It does not
    // prove the entry is true, but it does stop a list being stuffed in
    // a single request.
    function oneAtATime(before, after) {
      return after.toSet().difference(before.toSet()).size() <= 1
          && before.toSet().difference(after.toSet()).size() <= 1;
    }

    /* -----------------------------------------------------------------
       RATE LIMITS
       -----------------------------------------------------------------
       Rules cannot count writes over time on their own, so the count
       lives in a document the person owns — users/{uid}/private/limits
       — and the rule below pins every field in it to request.time, so
       it can only ever say "now". It cannot be backdated to buy another
       turn.

       The action and the stamp then go in ONE batched write, and the
       action's rule uses getAfter() to require that the stamp really
       landed in the same batch. Skipping the stamp is not a way round
       the limit: without it getAfter() does not match and the action
       itself is refused.

       This costs a couple of document accesses on the actions it
       guards. They are all things people do a handful of times a day —
       starting an event, asking to follow — never the hot paths.
       ----------------------------------------------------------------- */
    function limits() {
      return /databases/$(database)/documents/users/$(uid())/private/limits;
    }

    // The action is only allowed if the same batch stamped it.
    function stampedEvent() {
      return getAfter(limits()).data.eventAt == request.time;
    }
    function stampedAsk() {
      return getAfter(limits()).data.askAt == request.time;
    }

    function lastEventAt() {
      return exists(limits()) && 'eventAt' in get(limits()).data
        ? get(limits()).data.eventAt
        : timestamp.value(0);
    }
    function lastAskAt() {
      return exists(limits()) && 'askAt' in get(limits()).data
        ? get(limits()).data.askAt
        : timestamp.value(0);
    }

    // How many have been started since the window opened, and when it
    // opened. A window older than a day is treated as a fresh one.
    function eventWindowStart() {
      return exists(limits()) && 'eventWindowAt' in get(limits()).data
        ? get(limits()).data.eventWindowAt
        : timestamp.value(0);
    }
    function eventsInWindow() {
      return exists(limits()) && 'eventCount' in get(limits()).data
        ? get(limits()).data.eventCount
        : 0;
    }
    function windowIsOpen() {
      return eventWindowStart() > request.time - duration.value(1, 'd');
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // A block is stored once, under the two uids sorted and joined —
    // the same shape as a chat id, so for a direct chat the block doc
    // and the chat share a key.
    function pairKey(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function blockedWith(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(pairKey(uid(), otherUid)));
    }

    // True once both people have accepted each other. Costs a document
    // read, so it guards writes only (vouching), never a read path.
    function linkedWith(otherUid) {
      return exists(/databases/$(database)/documents/orbit/$(pairKey(uid(), otherUid)))
        && get(/databases/$(database)/documents/orbit/$(pairKey(uid(), otherUid))).data.status == 'linked';
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function handleIsMine(handle) {
      return exists(/databases/$(database)/documents/usernames/$(handle))
        && get(/databases/$(database)/documents/usernames/$(handle)).data.uid == uid();
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function haveNoHandleYet() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && !('username' in myProfile());
    }

    // ---------------------------------------------------------------
    // USERS  —  users/{userId}
    // ---------------------------------------------------------------
    match /users/{userId} {

      // Profiles are visible to signed-in students only, never to the
      // open internet. Note that no email is stored in this document.
      allow read: if signedIn();

      allow create: if isMe(userId)
        && request.resource.data.uid == userId
        && request.resource.data.banned == false
        // A handle can never be granted at creation time — it has to go
        // through the reservation flow below.
        && !('username' in request.resource.data)
        && isString(request.resource.data.displayName, 20)
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 300
        // Vouches and followers are given by other people. Neither can
        // be handed to yourself at sign-up.
        && !('vouchedBy' in request.resource.data)
        && !('followers' in request.resource.data)
        && !('following' in request.resource.data)
        && !('followRequests' in request.resource.data);

      allow update: if isMe(userId)
        // Fields the client is allowed to touch at all.
        && changedKeys().hasOnly(['username', 'displayName', 'avatar', 'googlePfp', 'updatedAt', 'following', 'private', 'bio', 'interests'])
        // ABOUT YOU. A short bio, and up to five interests from a fixed
        // list (js/services/aboutRules.js — keep the two in step).
        && (!(changedKeys().hasAny(['bio']))
            // 160 characters in the app; the rule allows more because an
            // emoji-heavy bio can count several times over here.
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 640))
        && (!(changedKeys().hasAny(['interests']))
            || (request.resource.data.interests is list
                && request.resource.data.interests.size() <= 5
                && request.resource.data.interests.hasOnly(['☕ Chill', '🍕 Food', '🎉 Party', '📚 Study', '🏀 Sports', '🎧 Music', '🎮 Gaming', '🎨 Art', '💻 Coding', '📸 Photos', '🎬 Movies', '🏋️ Gym', '✈️ Travel', '🎭 Theatre', '📖 Books'])))
        && (!(changedKeys().hasAny(['private'])) || request.resource.data.private is bool)
        // You keep your OWN following list, and only ever one name at a
        // time. Note the asymmetry, which is the point of the design:
        // `followers` below can only be written by the follower, so a
        // follower count is not something its owner can inflate.
        && (
             !(changedKeys().hasAny(['following']))
             || (
                  request.resource.data.following is list
                  && request.resource.data.following.size() <= 5000
                  && oneAtATime(
                       'following' in resource.data ? resource.data.following : [],
                       request.resource.data.following
                     )
                )
           )
        // Nobody promotes or un-bans themselves.
        // get() with a default, because a profile made before these two
        // fields existed doesn't have them — and a plain comparison with
        // a missing field is an error, which refused EVERY edit to that
        // profile: bio, name, avatar, privacy, following. Still nobody
        // can add, change or remove either one.
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('banned', null) == resource.data.get('banned', null)
        && (!(changedKeys().hasAny(['displayName'])) || isString(request.resource.data.displayName, 20))
        && (!(changedKeys().hasAny(['avatar'])) || request.resource.data.avatar.size() <= 300)
        // HANDLES ARE PERMANENT. Once set, it can never change; and it
        // can only be set to a handle already reserved by this uid.
        && (
             !(changedKeys().hasAny(['username']))
             || (
                  !('username' in resource.data)
                  && request.resource.data.username is string
                  && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
                  && handleIsMine(request.resource.data.username)
                )
           );

      // A VOUCH is someone else saying "I actually know this person",
      // and it is the only thing anyone may write on a profile that is
      // not their own. The guards, in order: you can only ever add or
      // remove YOURSELF from the list; you cannot touch any other
      // field; you must already be linked to them in orbit, which is
      // what stops a fresh account vouching for a hundred strangers;
      // and a block cancels it in either direction.
      allow update: if signedIn()
        && !isMe(userId)
        && changedKeys().hasOnly(['vouchedBy'])
        && request.resource.data.vouchedBy is list
        && request.resource.data.vouchedBy.size() <= 500
        && selfToggleOnly(
             'vouchedBy' in resource.data ? resource.data.vouchedBy : [],
             request.resource.data.vouchedBy
           )
        && linkedWith(userId)
        && !blockedWith(userId);

      // FOLLOWING is the light, public, one-way half of the graph: no
      // permission is asked, and the only thing it writes on someone
      // else's profile is the follower's own uid in their `followers`.
      //
      // That single restriction is what makes the number worth showing.
      // The owner of a profile cannot touch `followers` at all, and
      // nobody can add anyone but themselves, so a follower count can
      // only ever have been earned one real account at a time.
      allow update: if signedIn()
        && !isMe(userId)
        && changedKeys().hasOnly(['followers'])
        && listOr(request.resource.data, 'followers') is list
        && listOr(request.resource.data, 'followers').size() <= 5000
        && selfToggleOnly(
             listOr(resource.data, 'followers'),
             listOr(request.resource.data, 'followers')
           )
        // Everything below guards ADDING yourself only. Leaving somebody's
        // followers has to work whatever their settings say — and it
        // used to be refused once a block existed, so blocking someone
        // left you stuck in their follower list for good.
        && (
             !added(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')).hasAny([uid()])
             || (
                  // A PRIVATE account cannot be followed directly — you
                  // may only ask, below, and wait to be moved across.
                  resource.data.get('private', false) != true
                  && !blockedWith(userId)
                )
           );

      // ASKING TO FOLLOW a private account. Same shape as the rule
      // above — your own uid, nothing else, nobody else's — but it
      // lands in a queue the owner decides on rather than in the
      // follower list itself.
      allow update: if signedIn()
        && !isMe(userId)
        && changedKeys().hasOnly(['followRequests'])
        && listOr(request.resource.data, 'followRequests') is list
        && listOr(request.resource.data, 'followRequests').size() <= 5000
        && selfToggleOnly(
             listOr(resource.data, 'followRequests'),
             listOr(request.resource.data, 'followRequests')
           )
        // Withdrawing always works, block or no block. Asking only makes
        // sense while the account is actually private, from someone who
        // isn't already a follower, and not faster than one every three
        // seconds. (Ten seconds made asking two people back to back fail
        // the second one, which looked like a request vanishing.)
        && (
             !added(listOr(resource.data, 'followRequests'), listOr(request.resource.data, 'followRequests')).hasAny([uid()])
             || (
                  resource.data.get('private', false) == true
                  && !(uid() in listOr(resource.data, 'followers'))
                  && !blockedWith(userId)
                  && stampedAsk()
                  && lastAskAt() < request.time - duration.value(3, 's')
                )
           );

      // APPROVING OR DECLINING, by the owner and nobody else. This is
      // the only path that may write `followers` on your own profile,
      // and it is tightly bounded: exactly one name leaves the queue,
      // and the only name that may join the followers is that same one.
      // So approving cannot smuggle in somebody who never asked, and
      // nothing can be removed from the followers along the way.
      allow update: if isMe(userId)
        && changedKeys().hasOnly(['followers', 'followRequests'])
        // listOr on the AFTER side too. Declining writes only
        // followRequests, so on an account that had never had a follower
        // there was no `followers` field at all, `followers is list`
        // failed, and every decline was refused.
        && listOr(request.resource.data, 'followers') is list
        && listOr(request.resource.data, 'followRequests') is list
        && removed(listOr(resource.data, 'followRequests'), listOr(request.resource.data, 'followRequests')).size() == 1
        && added(listOr(resource.data, 'followRequests'), listOr(request.resource.data, 'followRequests')).size() == 0
        && removed(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')).size() == 0
        && added(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')).size() <= 1
        && removed(listOr(resource.data, 'followRequests'), listOr(request.resource.data, 'followRequests'))
             .hasAll(added(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')));

      // REMOVING A FOLLOWER, by the owner. One name out, nobody in, and
      // nothing else touched — so it can shrink a follower count but
      // never grow one. Without it there was no way to take someone out
      // of your followers at all, not even somebody you had blocked.
      allow update: if isMe(userId)
        && changedKeys().hasOnly(['followers'])
        && listOr(request.resource.data, 'followers') is list
        && removed(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')).size() == 1
        && added(listOr(resource.data, 'followers'), listOr(request.resource.data, 'followers')).size() == 0;

      // Accounts are never deleted from the client — that would free a
      // handle and orphan every event and message it owns.
      allow delete: if false;

      // THE RATE-LIMIT LEDGER. Owner-only like everything under
      // private/, but unlike everything else under private/ it is not
      // free-form: every timestamp in it must be request.time. That is
      // the whole trick — the client writes it, but can only ever write
      // "now" into it, so it cannot hand itself an earlier last-used
      // time and start again.
      match /private/limits {
        allow read: if isMe(userId);
        allow write: if isMe(userId)
          && request.resource.data.keys().hasOnly(
               ['eventAt', 'askAt', 'eventWindowAt', 'eventCount'])
          && (!('eventAt' in request.resource.data)
              || request.resource.data.eventAt == request.time)
          && (!('askAt' in request.resource.data)
              || request.resource.data.askAt == request.time)
          && (!('eventWindowAt' in request.resource.data)
              || request.resource.data.eventWindowAt == request.time
              || request.resource.data.eventWindowAt == resource.data.eventWindowAt)
          && (!('eventCount' in request.resource.data)
              || request.resource.data.eventCount is int);
      }

      // Email and anything else private. Only the owner, ever.
      match /private/{docId} {
        allow read, write: if isMe(userId);
      }
    }

    // ---------------------------------------------------------------
    // HANDLES  —  usernames/{handle}
    // ---------------------------------------------------------------
    match /usernames/{handle} {

      // Needed so the "is this taken?" check and the @handle chat
      // search work. Only maps a handle to a uid, nothing sensitive.
      allow read: if signedIn();

      // CREATE-ONLY is the uniqueness guarantee. Firestore treats a
      // write to an existing document as an update, and there is no
      // update rule here, so the second person to try a handle is
      // rejected by the database itself. No race, no server needed.
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        // One handle per account: you cannot reserve a second one.
        && haveNoHandleYet();

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // EVENTS  —  events/{eventId}
    // ---------------------------------------------------------------
    match /events/{eventId} {

      function isHost() {
        return signedIn() && resource.data.hostUid == uid();
      }

      function isParticipant() {
        return signedIn() && uid() in resource.data.participantUids;
      }

      function withinCapacity() {
        return request.resource.data.maxCapacity == null
            || request.resource.data.participantUids.size() <= request.resource.data.maxCapacity;
      }

      function needsApproval() {
        return resource.data.get('requiresApproval', false) == true;
      }

      function pendingBefore() { return resource.data.get('pendingUids', []).toSet(); }
      function pendingAfter()  { return request.resource.data.get('pendingUids', []).toSet(); }
      function goingBefore()   { return resource.data.participantUids.toSet(); }
      function goingAfter()    { return request.resource.data.participantUids.toSet(); }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostUid == uid()
        && isString(request.resource.data.title, 80)
        && isString(request.resource.data.place, 80)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.tag is string
        && request.resource.data.startTime is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.resource.data.startTime
        // A host cannot open with a pre-filled guest list or fake hype.
        && request.resource.data.participantUids == [uid()]
        && request.resource.data.hypedUids == []
        && request.resource.data.get('pendingUids', []) == []
        && request.resource.data.get('unconfirmedUids', []) == []
        && request.resource.data.get('requiresApproval', false) is bool
        && (request.resource.data.maxCapacity == null
            || (request.resource.data.maxCapacity is int && request.resource.data.maxCapacity > 1))

        // RATE LIMIT. Ninety seconds between events, and twenty-five in
        // any rolling day. A feed flooded by one bored person on launch
        // night is the single easiest way to kill this app, and it is
        // not something the client can be trusted to prevent.
        && stampedEvent()
        && lastEventAt() < request.time - duration.value(90, 's')
        && (
             !windowIsOpen()
             ? getAfter(limits()).data.eventCount == 1
                 && getAfter(limits()).data.eventWindowAt == request.time
             : eventsInWindow() < 25
                 && getAfter(limits()).data.eventCount == eventsInWindow() + 1
                 && getAfter(limits()).data.eventWindowAt == eventWindowStart()
           );

      // Two very different kinds of update, kept strictly apart.
      allow update: if
        // (a) The host editing their own event. Ownership is frozen.
        (
          isHost()
          // Details only. People are frozen here; the guest list moves
          // through branch (b) and self-service through branch (c).
          && changedKeys().hasOnly([
               'title', 'place', 'description', 'tag',
               'startTime', 'expiresAt', 'maxCapacity',
               'requiresApproval', 'updatedAt',
               'unconfirmedUids', 'lastEditSummary'
             ])
          // A host may flag attendees as needing to re-confirm, but the
          // flag can only ever name people who are actually going, and
          // never the host themselves. This is the whole point: after a
          // material change, "going" must not keep speaking for someone
          // who agreed to a different plan.
          && request.resource.data.get('unconfirmedUids', []).toSet()
               .difference(resource.data.participantUids.toSet()).size() == 0
          && !(resource.data.hostUid in request.resource.data.get('unconfirmedUids', []))
          && request.resource.data.get('lastEditSummary', '') is string
          && request.resource.data.get('lastEditSummary', '').size() <= 140
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.get('hypedUids', []) == resource.data.get('hypedUids', [])
          && request.resource.data.get('pendingUids', []) == resource.data.get('pendingUids', [])
          && isString(request.resource.data.title, 80)
          && isString(request.resource.data.place, 80)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.startTime is number
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.resource.data.startTime
          // Capacity cannot be cut below the people already going —
          // that would silently put the event over its own limit.
          && (request.resource.data.maxCapacity == null
              || (request.resource.data.maxCapacity is int
                  && request.resource.data.maxCapacity >= resource.data.participantUids.size()))
        )
        ||
        // (b) The host working through the guest list: approving or
        // declining requests, and removing someone already going.
        //
        // They may only ever REMOVE from pending, and may only ADD
        // someone who was actually pending — so a host cannot quietly
        // add a person who never asked. Removals are allowed, but the
        // host cannot remove themselves: an event with no host is
        // unmanageable and undeletable.
        (
          isHost()
          && changedKeys().hasOnly(['participantUids', 'pendingUids', 'unconfirmedUids'])
          && request.resource.data.get('unconfirmedUids', []).toSet()
               .difference(resource.data.get('unconfirmedUids', []).toSet()).size() == 0
          && pendingAfter().difference(pendingBefore()).size() == 0
          && goingAfter().difference(goingBefore()).difference(pendingBefore()).size() == 0
          && uid() in goingAfter()
          && withinCapacity()
        )
        ||
        // (c) Anyone else joining, leaving, requesting, hyping or
        // typing — and the ONLY thing they may change is their own.
        (
          signedIn()
          && changedKeys().hasOnly(['participantUids', 'hypedUids', 'typingUids', 'pendingUids', 'unconfirmedUids'])
          && selfToggleOnly(resource.data.participantUids, request.resource.data.participantUids)
          && selfToggleOnly(resource.data.get('hypedUids', []), request.resource.data.get('hypedUids', []))
          && selfToggleOnly(resource.data.get('typingUids', []), request.resource.data.get('typingUids', []))
          && selfToggleOnly(resource.data.get('pendingUids', []), request.resource.data.get('pendingUids', []))
          && selfToggleOnly(resource.data.get('unconfirmedUids', []), request.resource.data.get('unconfirmedUids', []))
          // Capacity is now enforced by the database, not just the UI.
          && withinCapacity()
          // Blocking is total: you cannot turn up at their event, and
          // they cannot turn up at yours.
          && !blockedWith(resource.data.hostUid)
          // On an approval-only event you may leave, but you may not
          // add yourself — that is the host's call, via branch (b).
          && (!needsApproval() || goingAfter().difference(goingBefore()).size() == 0)
        );

      allow delete: if isHost();

      // ---- Typing, in its own subcollection ----
      //
      // This used to live in `typingUids` ON the event document, which
      // every user with the app open is listening to. One person
      // typing therefore billed a read to the whole campus and
      // re-rendered everyone's feed. Down here only the people in that
      // chat are listening.
      match /typing/{typingUid} {
        function inEventChat() {
          return signedIn() && uid() in eventData(eventId).participantUids;
        }
        allow read: if inEventChat();
        allow write: if inEventChat() && typingUid == uid();
      }

      // ---- Event group chat ----
      // Messages are a SUBCOLLECTION so one lookup of the parent event
      // authorises the whole query, instead of one lookup per message.
      match /messages/{messageId} {

        function inEvent() {
          return signedIn() && uid() in eventData(eventId).participantUids;
        }

        allow read: if inEvent();

        allow create: if inEvent()
          && request.resource.data.senderUid == uid()
          && isString(request.resource.data.text, 2000)
          && request.resource.data.time is number;

        // Messages are immutable — nobody rewrites history.
        allow update: if false;

        // Sender can retract; host can moderate.
        allow delete: if signedIn()
          && (resource.data.senderUid == uid() || eventData(eventId).hostUid == uid());
      }
    }

    // ---------------------------------------------------------------
    // DIRECT CHATS  —  chats/{chatId}
    // ---------------------------------------------------------------
    match /chats/{chatId} {

      // TWO membership checks, because get and list are evaluated in
      // completely different ways and each needs the one it can verify.
      //
      // A chat id IS membership proof: it is the two uids, sorted and
      // joined by "_", and the create rule below refuses any id that
      // disagrees with its own userUids.
      function inThisChat() {
        return signedIn() && uid() in chatId.split('_');
      }
      function isMemberByData() {
        return signedIn() && uid() in resource.data.userUids;
      }

      // GET is evaluated against one known document path. Checking the
      // id works even when the document does not exist yet — reading
      // resource.data there evaluates against null, errors, and denies,
      // which is why the FIRST message to someone new used to fail.
      allow get: if inThisChat();

      // LIST is evaluated against the QUERY, before any document is
      // read: Firestore must prove upfront that the query can only
      // return rows you may see. It cannot derive that from a document
      // id, so an id-based rule rejects the whole inbox query — which
      // is why chats sent fine but never appeared in the list. This
      // check mirrors the query's own constraint
      // (where userUids array-contains uid), so Firestore can verify it.
      allow list: if isMemberByData();

      allow create: if inThisChat()
        && !exists(/databases/$(database)/documents/blocks/$(chatId))
        && uid() in request.resource.data.userUids
        && request.resource.data.userUids.size() == 2
        && request.resource.data.userUids[0] < request.resource.data.userUids[1]
        && chatId == request.resource.data.userUids[0] + '_' + request.resource.data.userUids[1]
        && request.resource.data.initiatedByUid == uid()
        && request.resource.data.status in ['unlocked', 'icebreaker']
        && request.resource.data.get('icebreakerUsed', false) is bool;

      allow update: if inThisChat()
        && changedKeys().hasOnly(['unreadByUid', 'typingUid', 'status', 'lastUpdated', 'icebreakerUsed'])
        // The icebreaker flag only ever goes from unset to true, and
        // only the person who opened the chat can set it.
        && (!(changedKeys().hasAny(['icebreakerUsed']))
            || (request.resource.data.icebreakerUsed == true
                && resource.data.get('icebreakerUsed', false) == false
                && resource.data.initiatedByUid == uid()))
        // The pair is fixed for the life of the chat.
        && request.resource.data.userUids == resource.data.userUids
        && request.resource.data.initiatedByUid == resource.data.initiatedByUid
        // You may only mark yourself as typing.
        && (!(changedKeys().hasAny(['typingUid']))
            || request.resource.data.typingUid == uid()
            || request.resource.data.typingUid == '')
        && (!(changedKeys().hasAny(['status']))
            || request.resource.data.status in ['unlocked', 'icebreaker']);

      // Keeping the thread means the icebreaker state can't be reset by
      // deleting and recreating the chat.
      allow delete: if false;

      match /messages/{messageId} {

        allow read: if inThisChat();

        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        // THE ICEBREAKER, for real this time.
        //
        // The app has always shown one message and then locked the box
        // until the other person replied — but only in the client, so
        // anybody willing to open the console could send a hundred. For
        // an app where a stranger can message any student by handle,
        // that is the thing most worth getting right.
        //
        // Now the single opening message must flip `icebreakerUsed` on
        // the chat in the same batch, and the flag can never go back.
        // There is exactly one such write, ever. The other person is
        // never limited — replying is what unlocks the thread.
        function icebreakerAllowed() {
          return chat().status != 'icebreaker'
              || chat().initiatedByUid != uid()
              || (chat().get('icebreakerUsed', false) == false
                  && chatAfter().icebreakerUsed == true);
        }

        // The chat id IS the block key for a direct chat, so this is a
        // single cheap existence check.
        allow create: if inThisChat()
          && !exists(/databases/$(database)/documents/blocks/$(chatId))
          && request.resource.data.senderUid == uid()
          && isString(request.resource.data.text, 2000)
          && request.resource.data.time is number
          && icebreakerAllowed();

        allow update: if false;
        allow delete: if signedIn() && resource.data.senderUid == uid();
      }
    }

    // ---------------------------------------------------------------
    // BLOCKS  —  blocks/{uidA_uidB}
    //
    // One document per pair, regardless of who blocked whom, so a block
    // is symmetrical by construction: neither side can reach the other
    // and neither can be "half unblocked". Only the person who created
    // it can lift it.
    // ---------------------------------------------------------------
    match /blocks/{pairId} {

      function inPair() {
        return signedIn() && uid() in pairId.split('_');
      }

      // get by id (works before it exists); list mirrors the client's
      // own query, `where pair array-contains uid`, so Firestore can
      // verify it upfront.
      allow get: if inPair();
      allow list: if signedIn() && uid() in resource.data.pair;

      allow create: if inPair()
        && request.resource.data.pair.size() == 2
        && uid() in request.resource.data.pair
        && request.resource.data.pair[0] < request.resource.data.pair[1]
        && pairId == request.resource.data.pair[0] + '_' + request.resource.data.pair[1]
        && request.resource.data.blockerUid == uid();

      // A block is not editable — lift it and make a new one.
      allow update: if false;

      // Only the blocker can unblock. The blocked person must not be
      // able to clear it themselves.
      allow delete: if signedIn() && resource.data.blockerUid == uid();
    }

    // ---------------------------------------------------------------
    // ORBIT  —  orbit/{uidA_uidB}
    //
    // A connection between two people, stored the same way as a block
    // or a direct chat: one document, id = the two uids sorted and
    // joined. `fromUid` records who asked and `status` is 'pending'
    // until the OTHER person accepts, so a single document carries both
    // the request and the connection and the two can never disagree.
    //
    // One document per pair also means one query — `pair array-contains
    // me` — returns your whole orbit and every request waiting on you,
    // in one listener.
    // ---------------------------------------------------------------
    match /orbit/{pairId} {

      function inPair() {
        return signedIn() && uid() in pairId.split('_');
      }

      function theOther() {
        return pairId.split('_')[0] == uid()
          ? pairId.split('_')[1]
          : pairId.split('_')[0];
      }

      // get by id answers "have I already asked?" before the document
      // exists; list mirrors the client's own query so Firestore can
      // verify it without reading anything.
      allow get: if inPair();
      allow list: if signedIn() && uid() in resource.data.pair;

      allow create: if inPair()
        && request.resource.data.keys().hasOnly(['pair', 'fromUid', 'status', 'at'])
        && request.resource.data.pair.size() == 2
        && request.resource.data.pair[0] < request.resource.data.pair[1]
        && pairId == request.resource.data.pair[0] + '_' + request.resource.data.pair[1]
        && uid() in request.resource.data.pair
        // You send your own requests. Nobody opens one on your behalf.
        && request.resource.data.fromUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.at is number
        && !blockedWith(theOther())
        // Orbit comes after following. You can only ask someone you are
        // actually in the followers of — checked on THEIR document, which
        // only they and their followers can change, not on your own
        // `following`, which you could write anything into.
        && uid() in get(/databases/$(database)/documents/users/$(theOther())).data.get('followers', [])
        // Same three-second gate as asking to follow, off the same
        // ledger — one person cannot paper the campus in requests.
        && stampedAsk()
        && lastAskAt() < request.time - duration.value(3, 's');

      // Accepting is the only edit, it only goes one way, and only the
      // person who RECEIVED the request can do it.
      allow update: if inPair()
        && resource.data.status == 'pending'
        && resource.data.fromUid != uid()
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'linked';

      // Withdraw, decline, or leave someone's orbit — all the same
      // delete, available to either side at any point.
      allow delete: if inPair();
    }

    // ---------------------------------------------------------------
    // REPORTS  —  write-only drop box
    //
    // Students can file; nobody can read, edit or delete from the
    // client. Read them in the Firebase console.
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt is number;

      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // DEFAULT DENY
    // Anything not matched above is refused. Never remove this.
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
