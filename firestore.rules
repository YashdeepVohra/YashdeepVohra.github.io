rules_version = '2';

// =====================================================================
// livesociya — Firestore Security Rules
// =====================================================================
//
// The whole point of moving from usernames to UIDs: every rule below
// decides using request.auth.uid, which the server already knows and
// cannot be forged. A username-keyed schema would need a document read
// on every single write just to answer "is this really you?".
//
// Deploy:   firebase deploy --only firestore:rules
// Test:     Firebase console > Firestore > Rules > Rules Playground
//
// Data model
//   users/{uid}                   public profile, incl. followerCount
//   users/{uid}/followers/{uid}   one document per follower
//   users/{uid}/followRequests/*  the queue on a private account
//   users/{uid}/private/{doc}     email etc. — owner only
//   usernames/{handle}            { uid } — handle reservation, create-once
//   events/{eventId}              hostUid, participantUids[], hypedUids[]
//   events/{eventId}/messages/*   event chat, participants only
//   chats/{uidA_uidB}             userUids[2], sorted, id == the join
//   chats/{chatId}/messages/*     direct messages, the two members only
//   orbit/{uidA_uidB}             a connection: pending, then linked
//                                 (follows live as arrays on users/*)
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMe(userId) {
      return signedIn() && uid() == userId;
    }

    // OPTIONAL CAMPUS LOCK ------------------------------------------
    // Replace the domain and swap signedIn() for campusMember() in the
    // read/write rules below to restrict the app to your college.
    // Google sign-in already verifies the email, so this cannot be
    // faked by editing the client.
    function campusMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@yourcollege[.]edu$');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when the only difference between two uid arrays is the
    // caller adding or removing THEMSELVES. This is what stops someone
    // signing other people up for events or faking hype counts.
    function selfToggleOnly(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([uid()])
          && before.toSet().difference(after.toSet()).hasOnly([uid()]);
    }

    // What a write adds to / removes from a list, as sets.


    // A list may gain or lose at most one entry per write. It does not
    // prove the entry is true, but it does stop a list being stuffed in
    // a single request.
    function oneAtATime(before, after) {
      return after.toSet().difference(before.toSet()).size() <= 1
          && before.toSet().difference(after.toSet()).size() <= 1;
    }

    /* -----------------------------------------------------------------
       RATE LIMITS
       -----------------------------------------------------------------
       Rules cannot count writes over time on their own, so the count
       lives in a document the person owns — users/{uid}/private/limits
       — and the rule below pins every field in it to request.time, so
       it can only ever say "now". It cannot be backdated to buy another
       turn.

       The action and the stamp then go in ONE batched write, and the
       action's rule uses getAfter() to require that the stamp really
       landed in the same batch. Skipping the stamp is not a way round
       the limit: without it getAfter() does not match and the action
       itself is refused.

       This costs a couple of document accesses on the actions it
       guards. They are all things people do a handful of times a day —
       starting an event, asking to follow — never the hot paths.
       ----------------------------------------------------------------- */
    function limits() {
      return /databases/$(database)/documents/users/$(uid())/private/limits;
    }

    // The action is only allowed if the same batch stamped it.
    function stampedEvent() {
      return getAfter(limits()).data.eventAt == request.time;
    }
    function stampedAsk() {
      return getAfter(limits()).data.askAt == request.time;
    }

    function lastEventAt() {
      return exists(limits()) && 'eventAt' in get(limits()).data
        ? get(limits()).data.eventAt
        : timestamp.value(0);
    }
    function lastAskAt() {
      return exists(limits()) && 'askAt' in get(limits()).data
        ? get(limits()).data.askAt
        : timestamp.value(0);
    }

    // How many have been started since the window opened, and when it
    // opened. A window older than a day is treated as a fresh one.
    function eventWindowStart() {
      return exists(limits()) && 'eventWindowAt' in get(limits()).data
        ? get(limits()).data.eventWindowAt
        : timestamp.value(0);
    }
    function eventsInWindow() {
      return exists(limits()) && 'eventCount' in get(limits()).data
        ? get(limits()).data.eventCount
        : 0;
    }
    function windowIsOpen() {
      return eventWindowStart() > request.time - duration.value(1, 'd');
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ---------------------------------------------------------------
    // EDITING AND RETRACTING A MESSAGE
    // ---------------------------------------------------------------
    //
    // Messages used to be flatly immutable (`allow update: if false`)
    // and that was the right default: nobody rewrites history. What
    // follows is the smallest possible hole in it.
    //
    // Only the sender may touch a message, and only in one of two
    // shapes:
    //
    //   an EDIT       new text plus an `editedAt` stamp, inside 15
    //                 minutes of sending, on a message that has not
    //                 been retracted. The stamp is what puts "edited"
    //                 on the bubble, so it is required — an edit
    //                 cannot be made silently.
    //
    //   a RETRACTION  text blanked, `deleted: true`, one way only.
    //                 The document stays, as a tombstone, which is
    //                 deliberate: see the note on the icebreaker below.
    //
    // Everything else on a message is still frozen — senderUid, time,
    // and the quoted reply cannot move, because hasOnly() names the
    // only keys a write may touch and neither shape names them.
    //
    // A tombstone rather than a real delete, because a deletable
    // message is a way out of the icebreaker: send your one opening
    // message, delete it, send another. The flag `icebreakerUsed` is
    // already one-way so the rules would refuse the second message
    // anyway, but the client counts messages on screen to decide
    // whether to lock the box, and a row that vanishes makes that
    // count lie. A tombstone keeps the count honest.
    function messageEditWindow() {
      return duration.value(15, 'm');
    }

    /* -----------------------------------------------------------------
       A client-supplied millisecond stamp that could plausibly be now.
       `time` used to be checked with `is number` and nothing else. A
       thread is ordered by it and only the newest 25 carry a listener,
       so a message dated 2099 pinned itself to the top of everybody's
       live window for good — it could never be scrolled past, and no
       window would ever age it out.
       The past side is deliberately generous: offline persistence means
       a message written on the bus commits whenever the phone next
       reaches the network, and that stamp is honestly old.
       ----------------------------------------------------------------- */
    function sensibleTime(ms) {
      return ms is number
        && timestamp.value(ms) < request.time + duration.value(2, 'm')
        && timestamp.value(ms) > request.time - duration.value(7, 'd');
    }

    function isMessageSender() {
      return signedIn() && resource.data.senderUid == uid();
    }

    function messageLives() {
      return resource.data.get('deleted', false) == false;
    }

    // `time` is the client clock at send; request.time is the server's.
    // Comparing them is a little loose, but it is loose in the safe
    // direction: a device running slow gets a shorter window, not a
    // longer one, and a device running fast cannot reopen the window
    // on a message the server already saw arrive.
    function insideEditWindow() {
      return request.time < timestamp.value(resource.data.time) + messageEditWindow();
    }

    function isTextEdit() {
      return changedKeys().hasOnly(['text', 'editedAt'])
        && isString(request.resource.data.text, 2000)
        // The server's clock. "Edited at" is shown to the other person,
        // so it is not the sender's to choose either — and a stamp that
        // can be typed is no use as a receipt.
        && request.resource.data.editedAt == request.time
        && messageLives()
        && insideEditWindow();
    }

    function isRetraction() {
      return changedKeys().hasOnly(['text', 'replyTo', 'editedAt', 'deleted', 'deletedAt'])
        && request.resource.data.deleted == true
        && request.resource.data.text == ''
        && request.resource.data.deletedAt == request.time
        // One way. A tombstone never comes back to life.
        && messageLives();
    }

    // No window on a retraction: taking something back is always
    // allowed, it is only rewriting that has a clock on it.
    function senderMayRewrite() {
      return isMessageSender() && (isTextEdit() || isRetraction());
    }

    // ---------------------------------------------------------------
    // REACTING TO A MESSAGE
    // ---------------------------------------------------------------
    //
    // `reactions` is a map keyed by uid: { uid: emoji }. Keyed that way
    // because it makes this rule one diff check — you may change your
    // own key and nobody else's — instead of having to reason about
    // who is inside which array. It is the same idea as
    // selfToggleOnly() above, for a map.
    //
    // The emoji list is fixed and mirrored in
    // js/services/messageRules.js. An open string here would be a
    // second way to put arbitrary text into somebody's thread, one
    // that skips every length and escaping rule the message body has.
    //
    // Anyone who can read the thread can react; the caller's own rule
    // adds the membership check, because it differs between an event
    // chat and a direct one.
    function reactionSet() {
      return ['👍', '❤️', '😂', '😮', '😢', '🔥'];
    }

    function reactionsBefore() {
      return resource.data.get('reactions', {});
    }

    function isReactionToggle() {
      return signedIn()
        && changedKeys().hasOnly(['reactions'])
        && messageLives()
        // Exactly one key may move, and it must be yours.
        && request.resource.data.reactions.diff(reactionsBefore())
             .affectedKeys().hasOnly([uid()])
        // Clearing yours removes the key; setting it must be one of ours.
        && (!(uid() in request.resource.data.reactions)
            || request.resource.data.reactions[uid()] in reactionSet());
    }

    // A block is stored once, under the two uids sorted and joined —
    // the same shape as a chat id, so for a direct chat the block doc
    // and the chat share a key.
    /* -----------------------------------------------------------------
       THE FOLLOW GRAPH
       -----------------------------------------------------------------
       `followers` and `followRequests` used to be ARRAYS on the profile
       document, capped at 5000 because that is roughly where an array of
       uids starts threatening the 1 MiB a document is allowed. The cap
       was never a product decision — nobody decided 5000 people was
       enough — it was the shape leaking into the product. Three things
       came with it: every read of a profile dragged the whole list down
       the wire, every follow rewrote the whole document, and any signed
       in account could read a private account's entire follower list
       straight out of the document the app was pretending to hide.

       One document per edge fixes all three. The list is a subcollection
       with a read rule of its own, a follow writes a NEW document rather
       than rewriting a big one, and there is no ceiling.

       What is left on the profile is `followerCount`, an integer, and it
       still cannot be inflated by its owner: it may only move in the
       same write that provably creates or deletes the matching follower
       document, and `followerEdge` names whose. So a count still has to
       be earned one real account at a time.
       ----------------------------------------------------------------- */
    function profileOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function accountIsPrivate(userId) {
      return profileOf(userId).get('private', false) == true;
    }
    function followerPath(userId, other) {
      return /databases/$(database)/documents/users/$(userId)/followers/$(other);
    }
    function askPath(userId, other) {
      return /databases/$(database)/documents/users/$(userId)/followRequests/$(other);
    }
    function iFollow(userId) {
      return exists(followerPath(userId, uid()));
    }
    function followerAdded(userId, other) {
      return !exists(followerPath(userId, other))
          && existsAfter(followerPath(userId, other));
    }
    function followerRemoved(userId, other) {
      return exists(followerPath(userId, other))
          && !existsAfter(followerPath(userId, other));
    }
    // The count may only move WITH the document it is counting.
    function countFollowsTheEdge(userId, other) {
      return (followerAdded(userId, other)
               && request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1)
          || (followerRemoved(userId, other)
               && request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1);
    }

    /* -----------------------------------------------------------------
       WHEN AN EVENT RUNS
       -----------------------------------------------------------------
       An event's start and end are CHOSEN — somebody picks them in a
       date field — so unlike a message's `time` they are not "now" and
       cannot be request.time. But nothing bounded them at all, and the
       live feed is

           where expiresAt > now, order by expiresAt DESC, limit 60

       so the sixty events with the furthest-away end date ARE the feed,
       for everybody. Sixty events dated the year 9999 would have been
       the entire campus feed, permanently, and not one of them would
       ever have moved to Recap. The app already refused a run longer
       than a week — only the app did.
       ----------------------------------------------------------------- */
    /* -----------------------------------------------------------------
       CIRCLES
       -----------------------------------------------------------------
       A circle is who shares a feed with you — a place or a community
       you belong to. The feed is partitioned by it; the social graph is
       not, so following, chat and orbit all still work across circles.

       An event may only be published into the host's OWN circle, which
       is one document access on a write that is already rate-limited
       and already reads that document. Without it, anyone could post
       into any circle's feed — the same hole as an unbounded expiresAt,
       reached a different way.

       `geo` is stored and nothing queries it yet. See geoRules.js: it
       is here so the day the feed becomes "near me", every event
       already carries a position and no document has to be rewritten.
       ----------------------------------------------------------------- */
    function myCircle() {
      return myProfile().get('circleId', 'main');
    }
    function sensibleGeo(geo) {
      return geo == null
        || (geo.keys().hasOnly(['lat', 'lng', 'geohash'])
            && geo.lat is number && geo.lat >= -90 && geo.lat <= 90
            && geo.lng is number && geo.lng >= -180 && geo.lng <= 180
            && geo.geohash is string && geo.geohash.size() <= 12);
    }

    function sensibleEventWindow(startTime, expiresAt) {
      return startTime is number
        && expiresAt is number
        && expiresAt > startTime
        && timestamp.value(expiresAt) <= timestamp.value(startTime) + duration.value(7, 'd')
        && timestamp.value(startTime) < request.time + duration.value(90, 'd')
        && timestamp.value(startTime) > request.time - duration.value(30, 'd');
    }

    /* A REAL Timestamp, so that Firestore's TTL can one day sweep
       finished events away: a TTL policy can only be set on a Timestamp
       field, and it cannot be added to documents that already exist
       without rewriting every one of them. So it goes in now, while
       there is nothing to rewrite.
       Mirrors EVENT_TTL_AFTER_MS in js/services/recapRules.js — change
       it in both or every publish is refused.
       NOT SAFE TO ENABLE YET: TTL does not cascade any more than a
       manual delete does, so it would leave every event's messages
       behind, unreachable. */
    function ttlFollowsExpiry() {
      return request.resource.data.ttlAt
        == timestamp.value(request.resource.data.expiresAt) + duration.value(72, 'h');
    }

    function pairKey(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function blockedWith(otherUid) {
      return exists(/databases/$(database)/documents/blocks/$(pairKey(uid(), otherUid)));
    }

    // True once both people have accepted each other. Costs a document
    // read, so it guards writes only (vouching), never a read path.
    function linkedWith(otherUid) {
      return exists(/databases/$(database)/documents/orbit/$(pairKey(uid(), otherUid)))
        && get(/databases/$(database)/documents/orbit/$(pairKey(uid(), otherUid))).data.status == 'linked';
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function handleIsMine(handle) {
      return exists(/databases/$(database)/documents/usernames/$(handle))
        && get(/databases/$(database)/documents/usernames/$(handle)).data.uid == uid();
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function haveNoHandleYet() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && !('username' in myProfile());
    }

    // ---------------------------------------------------------------
    // USERS  —  users/{userId}
    // ---------------------------------------------------------------
    match /users/{userId} {

      // Profiles are visible to signed-in students only, never to the
      // open internet. Note that no email is stored in this document.
      allow read: if signedIn();

      allow create: if isMe(userId)
        && request.resource.data.uid == userId
        && request.resource.data.banned == false
        // A handle can never be granted at creation time — it has to go
        // through the reservation flow below.
        && !('username' in request.resource.data)
        && isString(request.resource.data.displayName, 20)
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 300
        // Vouches and followers are given by other people. Neither can
        // be handed to yourself at sign-up.
        && !('vouchedBy' in request.resource.data)
        && !('followers' in request.resource.data)
        && !('following' in request.resource.data)
        && !('followRequests' in request.resource.data)
        && !('followerCount' in request.resource.data)
        && !('followerEdge' in request.resource.data);

      allow update: if isMe(userId)
        // Fields the client is allowed to touch at all.
        && changedKeys().hasOnly(['username', 'displayName', 'avatar', 'googlePfp', 'updatedAt', 'following', 'private', 'bio', 'interests', 'circleId'])
        && (!(changedKeys().hasAny(['circleId']))
            || (request.resource.data.circleId is string
                && request.resource.data.circleId.matches('^[A-Za-z0-9_-]{1,64}$')))
        // ABOUT YOU. A short bio, and up to five interests from a fixed
        // list (js/services/aboutRules.js — keep the two in step).
        && (!(changedKeys().hasAny(['bio']))
            // 160 characters in the app; the rule allows more because an
            // emoji-heavy bio can count several times over here.
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 640))
        && (!(changedKeys().hasAny(['interests']))
            || (request.resource.data.interests is list
                && request.resource.data.interests.size() <= 5
                && request.resource.data.interests.hasOnly(['☕ Chill', '🍕 Food', '🎉 Party', '📚 Study', '🏀 Sports', '🎧 Music', '🎮 Gaming', '🎨 Art', '💻 Coding', '📸 Photos', '🎬 Movies', '🏋️ Gym', '✈️ Travel', '🎭 Theatre', '📖 Books'])))
        && (!(changedKeys().hasAny(['private'])) || request.resource.data.private is bool)
        // You keep your OWN following list, and only ever one name at a
        // time. This one stays an array on purpose: only you write it,
        // so there is no contention, and one read gives the app your
        // whole list — which is what answers "am I following them?" on
        // every card in the feed, for free. It is `followers` that had
        // to move, because that one is written by other people and has
        // no natural ceiling.
        && (
             !(changedKeys().hasAny(['following']))
             || (
                  request.resource.data.following is list
                  && request.resource.data.following.size() <= 5000
                  && oneAtATime(
                       'following' in resource.data ? resource.data.following : [],
                       request.resource.data.following
                     )
                )
           )
        // Nobody promotes or un-bans themselves.
        // get() with a default, because a profile made before these two
        // fields existed doesn't have them — and a plain comparison with
        // a missing field is an error, which refused EVERY edit to that
        // profile: bio, name, avatar, privacy, following. Still nobody
        // can add, change or remove either one.
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('banned', null) == resource.data.get('banned', null)
        && (!(changedKeys().hasAny(['displayName'])) || isString(request.resource.data.displayName, 20))
        && (!(changedKeys().hasAny(['avatar'])) || request.resource.data.avatar.size() <= 300)
        // HANDLES ARE PERMANENT. Once set, it can never change; and it
        // can only be set to a handle already reserved by this uid.
        && (
             !(changedKeys().hasAny(['username']))
             || (
                  !('username' in resource.data)
                  && request.resource.data.username is string
                  && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
                  && handleIsMine(request.resource.data.username)
                )
           );

      // A VOUCH is someone else saying "I actually know this person",
      // and it is the only thing anyone may write on a profile that is
      // not their own. The guards, in order: you can only ever add or
      // remove YOURSELF from the list; you cannot touch any other
      // field; you must already be linked to them in orbit, which is
      // what stops a fresh account vouching for a hundred strangers;
      // and a block cancels it in either direction.
      allow update: if signedIn()
        && !isMe(userId)
        && changedKeys().hasOnly(['vouchedBy'])
        && request.resource.data.vouchedBy is list
        && request.resource.data.vouchedBy.size() <= 500
        && selfToggleOnly(
             'vouchedBy' in resource.data ? resource.data.vouchedBy : [],
             request.resource.data.vouchedBy
           )
        && linkedWith(userId)
        && !blockedWith(userId);

      // THE FOLLOWER COUNT. The list itself lives in the `followers`
      // subcollection below; this is the number on the profile, and it
      // is the only thing about the follow graph still written here.
      //
      // It may move by exactly one, and only in the same write that
      // provably creates or deletes the matching follower document —
      // `followerEdge` names whose, and existsAfter() checks it landed.
      // So the owner of a profile still cannot inflate their own count:
      // to add one they have to add a real follower document, and the
      // rule on that document decides whether they are allowed to.
      //
      // Anyone signed in may make this write, because a follower is not
      // the profile's owner. The edge rule is what does the guarding.
      allow update: if signedIn()
        && changedKeys().hasOnly(['followerCount', 'followerEdge'])
        && request.resource.data.followerCount is int
        && request.resource.data.followerCount >= 0
        && request.resource.data.followerEdge is string
        && (
             // Following or unfollowing: only ever yourself.
             request.resource.data.followerEdge == uid()
             // Approving or removing: the owner, about somebody else.
             || isMe(userId)
           )
        && countFollowsTheEdge(userId, request.resource.data.followerEdge);

      // Accounts are never deleted from the client — that would free a
      // handle and orphan every event and message it owns.
      allow delete: if false;

      /* FOLLOWERS — one document per follower.
         The id IS the follower's uid, which means "this row is mine" is
         a comparison rather than a list search, and two people following
         at the same moment write two different documents instead of
         racing over one array. */
      match /followers/{followerUid} {

        // The COUNT stays public on the profile; the LIST does not. This
        // is the wall the app only ever pretended to have: a private
        // account's followers were readable straight off the document by
        // anyone signed in, whatever the UI showed.
        allow get: if signedIn();
        allow list: if signedIn()
          && (isMe(userId)
              || !accountIsPrivate(userId)
              || iFollow(userId));

        allow create: if request.resource.data.keys().hasOnly(['at'])
          // The server's clock. The list is read newest-first, so a
          // number the follower chose is a number that decides where
          // they sit in it.
          && request.resource.data.at == request.time
          && (
               // Following someone: your own row, a public account, and
               // not across a block.
               (isMe(followerUid)
                 && !accountIsPrivate(userId)
                 && !blockedWith(userId))
               ||
               // Or the owner approving — and only somebody who really
               // asked. exists() sees the state BEFORE this batch, so
               // the request row is still there to vouch for them.
               (isMe(userId) && exists(askPath(userId, followerUid)))
             );

        // A follow is not an editable thing; it is there or it is not.
        allow update: if false;

        // Leaving always works, block or no block — being blocked used
        // to leave you stuck in somebody's follower list for good. And
        // the owner can always take someone out.
        allow delete: if isMe(followerUid) || isMe(userId);
      }

      /* FOLLOW REQUESTS — the queue on a private account. */
      match /followRequests/{askerUid} {

        // The owner sees the queue. An asker can read their own row and
        // nobody else's, which is how the app knows to say "Requested"
        // without being able to read the whole queue.
        allow get: if isMe(userId) || isMe(askerUid);
        allow list: if isMe(userId);

        allow create: if isMe(askerUid)
          && request.resource.data.keys().hasOnly(['at'])
          // Same: the queue is read newest-first and capped, so a
          // forged stamp is a way to sit at the top of it — or to push
          // somebody else off the end.
          && request.resource.data.at == request.time
          // Asking only means anything while the account is private,
          // from someone who is not already in, and not across a block.
          && accountIsPrivate(userId)
          && !exists(followerPath(userId, askerUid))
          && !blockedWith(userId)
          // One ask every three seconds, off the same ledger as orbit.
          && stampedAsk()
          && lastAskAt() < request.time - duration.value(3, 's');

        allow update: if false;

        // Withdrawing (the asker), approving or declining (the owner).
        allow delete: if isMe(askerUid) || isMe(userId);
      }

      // THE RATE-LIMIT LEDGER. Owner-only like everything under
      // private/, but unlike everything else under private/ it is not
      // free-form: every timestamp in it must be request.time. That is
      // the whole trick — the client writes it, but can only ever write
      // "now" into it, so it cannot hand itself an earlier last-used
      // time and start again.
      match /private/limits {
        allow read: if isMe(userId);
        allow write: if isMe(userId)
          && request.resource.data.keys().hasOnly(
               ['eventAt', 'askAt', 'eventWindowAt', 'eventCount'])
          && (!('eventAt' in request.resource.data)
              || request.resource.data.eventAt == request.time)
          && (!('askAt' in request.resource.data)
              || request.resource.data.askAt == request.time)
          && (!('eventWindowAt' in request.resource.data)
              || request.resource.data.eventWindowAt == request.time
              || request.resource.data.eventWindowAt == resource.data.eventWindowAt)
          && (!('eventCount' in request.resource.data)
              || request.resource.data.eventCount is int);
      }

      // Email and anything else private. Only the owner, ever.
      match /private/{docId} {
        allow read, write: if isMe(userId);
      }
    }

    // ---------------------------------------------------------------
    // HANDLES  —  usernames/{handle}
    // ---------------------------------------------------------------
    match /usernames/{handle} {

      // Needed so the "is this taken?" check and the @handle chat
      // search work. Only maps a handle to a uid, nothing sensitive.
      allow read: if signedIn();

      // CREATE-ONLY is the uniqueness guarantee. Firestore treats a
      // write to an existing document as an update, and there is no
      // update rule here, so the second person to try a handle is
      // rejected by the database itself. No race, no server needed.
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.createdAt == request.time
        // One handle per account: you cannot reserve a second one.
        && haveNoHandleYet();

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // EVENTS  —  events/{eventId}
    // ---------------------------------------------------------------
    match /events/{eventId} {

      function isHost() {
        return signedIn() && resource.data.hostUid == uid();
      }

      function isParticipant() {
        return signedIn() && uid() in resource.data.participantUids;
      }

      function withinCapacity() {
        return request.resource.data.maxCapacity == null
            || request.resource.data.participantUids.size() <= request.resource.data.maxCapacity;
      }

      function needsApproval() {
        return resource.data.get('requiresApproval', false) == true;
      }

      function pendingBefore() { return resource.data.get('pendingUids', []).toSet(); }
      function pendingAfter()  { return request.resource.data.get('pendingUids', []).toSet(); }
      function goingBefore()   { return resource.data.participantUids.toSet(); }
      function goingAfter()    { return request.resource.data.participantUids.toSet(); }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostUid == uid()
        && isString(request.resource.data.title, 80)
        && isString(request.resource.data.place, 80)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.tag is string
        && sensibleEventWindow(request.resource.data.startTime, request.resource.data.expiresAt)
        && ttlFollowsExpiry()
        && request.resource.data.createdAt == request.time
        && request.resource.data.circleId == myCircle()
        && sensibleGeo(request.resource.data.get('geo', null))
        // A host cannot open with a pre-filled guest list or fake hype.
        && request.resource.data.participantUids == [uid()]
        && request.resource.data.hypedUids == []
        && request.resource.data.get('pendingUids', []) == []
        && request.resource.data.get('unconfirmedUids', []) == []
        && request.resource.data.get('requiresApproval', false) is bool
        && (request.resource.data.maxCapacity == null
            || (request.resource.data.maxCapacity is int && request.resource.data.maxCapacity > 1))

        // RATE LIMIT. Ninety seconds between events, and twenty-five in
        // any rolling day. A feed flooded by one bored person on launch
        // night is the single easiest way to kill this app, and it is
        // not something the client can be trusted to prevent.
        && stampedEvent()
        && lastEventAt() < request.time - duration.value(90, 's')
        && (
             !windowIsOpen()
             ? getAfter(limits()).data.eventCount == 1
                 && getAfter(limits()).data.eventWindowAt == request.time
             : eventsInWindow() < 25
                 && getAfter(limits()).data.eventCount == eventsInWindow() + 1
                 && getAfter(limits()).data.eventWindowAt == eventWindowStart()
           );

      // Two very different kinds of update, kept strictly apart.
      allow update: if
        // (a) The host editing their own event. Ownership is frozen.
        (
          isHost()
          // Details only. People are frozen here; the guest list moves
          // through branch (b) and self-service through branch (c).
          && changedKeys().hasOnly([
               'title', 'place', 'description', 'tag',
               'startTime', 'expiresAt', 'ttlAt', 'maxCapacity',
               'requiresApproval', 'updatedAt',
               'unconfirmedUids', 'lastEditSummary'
             ])
          // A host may flag attendees as needing to re-confirm, but the
          // flag can only ever name people who are actually going, and
          // never the host themselves. This is the whole point: after a
          // material change, "going" must not keep speaking for someone
          // who agreed to a different plan.
          && request.resource.data.get('unconfirmedUids', []).toSet()
               .difference(resource.data.participantUids.toSet()).size() == 0
          && !(resource.data.hostUid in request.resource.data.get('unconfirmedUids', []))
          && request.resource.data.get('lastEditSummary', '') is string
          && request.resource.data.get('lastEditSummary', '').size() <= 140
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.get('hypedUids', []) == resource.data.get('hypedUids', [])
          && request.resource.data.get('pendingUids', []) == resource.data.get('pendingUids', [])
          && isString(request.resource.data.title, 80)
          && isString(request.resource.data.place, 80)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && sensibleEventWindow(request.resource.data.startTime, request.resource.data.expiresAt)
          && ttlFollowsExpiry()
          // Capacity cannot be cut below the people already going —
          // that would silently put the event over its own limit.
          && (request.resource.data.maxCapacity == null
              || (request.resource.data.maxCapacity is int
                  && request.resource.data.maxCapacity >= resource.data.participantUids.size()))
        )
        ||
        // (b) The host working through the guest list: approving or
        // declining requests, and removing someone already going.
        //
        // They may only ever REMOVE from pending, and may only ADD
        // someone who was actually pending — so a host cannot quietly
        // add a person who never asked. Removals are allowed, but the
        // host cannot remove themselves: an event with no host is
        // unmanageable and undeletable.
        (
          isHost()
          && changedKeys().hasOnly(['participantUids', 'pendingUids', 'unconfirmedUids'])
          && request.resource.data.get('unconfirmedUids', []).toSet()
               .difference(resource.data.get('unconfirmedUids', []).toSet()).size() == 0
          && pendingAfter().difference(pendingBefore()).size() == 0
          && goingAfter().difference(goingBefore()).difference(pendingBefore()).size() == 0
          && uid() in goingAfter()
          && withinCapacity()
        )
        ||
        // (c) Anyone else joining, leaving, requesting, hyping or
        // typing — and the ONLY thing they may change is their own.
        (
          signedIn()
          && changedKeys().hasOnly(['participantUids', 'hypedUids', 'pendingUids', 'unconfirmedUids'])
          && selfToggleOnly(resource.data.participantUids, request.resource.data.participantUids)
          && selfToggleOnly(resource.data.get('hypedUids', []), request.resource.data.get('hypedUids', []))
          && selfToggleOnly(resource.data.get('pendingUids', []), request.resource.data.get('pendingUids', []))
          && selfToggleOnly(resource.data.get('unconfirmedUids', []), request.resource.data.get('unconfirmedUids', []))
          // Capacity is now enforced by the database, not just the UI.
          && withinCapacity()
          // Blocking is total: you cannot turn up at their event, and
          // they cannot turn up at yours.
          && !blockedWith(resource.data.hostUid)
          // On an approval-only event you may leave, but you may not
          // add yourself — that is the host's call, via branch (b).
          && (!needsApproval() || goingAfter().difference(goingBefore()).size() == 0)
        )
        ||
        (
          /* END IT NOW.
             The edit branch above insists expiresAt > startTime, which is
             right for an edit and wrong for ending something: a host
             calling off an event that had not started yet was writing an
             expiresAt BELOW startTime, and the rule refused it. The card
             faded out locally and the event stayed live for everyone else.
             So ending is its own act: one field, only the host, and only
             ever earlier than it already was. An expiresAt that lands
             below startTime is exactly what wasCalledOff() reads in
             recapRules.js — a state that was unreachable until now. */
          isHost()
          && changedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt < resource.data.expiresAt
        );

      allow delete: if isHost();

      // ---- Typing, in its own subcollection ----
      //
      // This used to live in `typingUids` ON the event document, which
      // every user with the app open is listening to. One person
      // typing therefore billed a read to the whole campus and
      // re-rendered everyone's feed. Down here only the people in that
      // chat are listening.
      match /typing/{typingUid} {
        function inEventChat() {
          return signedIn() && uid() in eventData(eventId).participantUids;
        }
        allow read: if inEventChat();
        // Only yours to write, only the one field, and the stamp is the
        // server's: the indicator shows while `at` is inside six
        // seconds, so a number of your own choosing left you typing at
        // everybody in the event chat for as long as you liked.
        allow write: if inEventChat()
          && typingUid == uid()
          && (request.method == 'delete'
              || (request.resource.data.keys().hasOnly(['at'])
                  && request.resource.data.at == request.time));
        // Only yours to write — but the host has to be able to clear
        // ALL of them when deleting the event. Anything left under a
        // deleted event is unreachable: every rule in here authorises
        // itself by reading the parent, and the parent is gone.
        allow delete: if signedIn() && eventData(eventId).hostUid == uid();
      }

      // ---- The pinned message ----
      //
      // One document, always called `current`, holding a COPY of the
      // pinned message: its id, its text, and who wrote it.
      //
      // Two decisions worth keeping. It is a subcollection rather than
      // a field on the event, for the same reason typing moved down
      // here: the event document is watched by everyone with the app
      // open, so a field on it bills a read to the whole campus every
      // time the host pins something. Down here only the people in
      // that chat pay.
      //
      // And it holds a copy of the text rather than just the id,
      // because the pinned message is usually the FIRST one ("meet by
      // the north gate") and by then it has scrolled out of the live
      // window — an id alone would cost a second read to display, on
      // every open, forever.
      match /pinned/{pinId} {
        function inEventChat() {
          return signedIn() && uid() in eventData(eventId).participantUids;
        }
        allow read: if inEventChat();

        // The host's call, and only ever the one document.
        allow write: if signedIn()
          && eventData(eventId).hostUid == uid()
          && pinId == 'current'
          && (request.method == 'delete'
              || (isString(request.resource.data.text, 300)
                  && isString(request.resource.data.messageId, 128)
                  && request.resource.data.senderUid is string));
      }

      // ---- Event group chat ----
      // Messages are a SUBCOLLECTION so one lookup of the parent event
      // authorises the whole query, instead of one lookup per message.
      match /messages/{messageId} {

        function inEvent() {
          return signedIn() && uid() in eventData(eventId).participantUids;
        }

        allow read: if inEvent();

        allow create: if inEvent()
          && request.resource.data.senderUid == uid()
          && isString(request.resource.data.text, 2000)
          && sensibleTime(request.resource.data.time);

        // Your own message, and only as an edit or a retraction — or
        // anybody in the event moving their own reaction. See the
        // block next to isString() for all three shapes.
        allow update: if (isMessageSender() && senderMayRewrite())
          || (inEvent() && isReactionToggle());

        // The host still gets a real delete, because moderation is not
        // the same act as taking back something you said: a tombstone
        // reading "this message was deleted" over a slur is a worse
        // outcome than the row being gone.
        allow delete: if signedIn() && eventData(eventId).hostUid == uid();
      }
    }

    // ---------------------------------------------------------------
    // DIRECT CHATS  —  chats/{chatId}
    // ---------------------------------------------------------------
    match /chats/{chatId} {

      // TWO membership checks, because get and list are evaluated in
      // completely different ways and each needs the one it can verify.
      //
      // A chat id IS membership proof: it is the two uids, sorted and
      // joined by "_", and the create rule below refuses any id that
      // disagrees with its own userUids.
      function inThisChat() {
        return signedIn() && uid() in chatId.split('_');
      }
      function isMemberByData() {
        return signedIn() && uid() in resource.data.userUids;
      }

      // GET is evaluated against one known document path. Checking the
      // id works even when the document does not exist yet — reading
      // resource.data there evaluates against null, errors, and denies,
      // which is why the FIRST message to someone new used to fail.
      allow get: if inThisChat();

      // LIST is evaluated against the QUERY, before any document is
      // read: Firestore must prove upfront that the query can only
      // return rows you may see. It cannot derive that from a document
      // id, so an id-based rule rejects the whole inbox query — which
      // is why chats sent fine but never appeared in the list. This
      // check mirrors the query's own constraint
      // (where userUids array-contains uid), so Firestore can verify it.
      allow list: if isMemberByData();

      /* THE INBOX PREVIEW. lastText is a copy of the newest message
         (messageRules.previewOf, 90 chars; 120 here so the "…" always
         fits), lastMsgId says which message, lastSenderUid who sent it.
         Whoever writes a preview must name THEMSELVES as its sender, so
         nobody can put words in the other person's mouth in your list.
         "" is allowed: it is how a deleted last message reads. */
      function previewOk(d) {
        return (!('lastText' in d) && !('lastMsgId' in d) && !('lastSenderUid' in d))
          || (d.get('lastText', '') is string && d.get('lastText', '').size() <= 120
              && d.get('lastMsgId', '') is string && d.get('lastMsgId', '').size() <= 64
              && d.get('lastSenderUid', '') == uid());
      }

      allow create: if inThisChat()
        && !exists(/databases/$(database)/documents/blocks/$(chatId))
        && previewOk(request.resource.data)
        && uid() in request.resource.data.userUids
        && request.resource.data.userUids.size() == 2
        && request.resource.data.userUids[0] < request.resource.data.userUids[1]
        && chatId == request.resource.data.userUids[0] + '_' + request.resource.data.userUids[1]
        && request.resource.data.initiatedByUid == uid()
        && request.resource.data.status in ['unlocked', 'icebreaker']
        && request.resource.data.get('icebreakerUsed', false) is bool
        && request.resource.data.createdAt == request.time
        && sensibleTime(request.resource.data.lastUpdated);

      allow update: if inThisChat()
        && changedKeys().hasOnly(['unreadByUid', 'typingUid', 'status', 'lastUpdated', 'icebreakerUsed',
                                  'lastText', 'lastMsgId', 'lastSenderUid'])
        && (!(changedKeys().hasAny(['lastText', 'lastMsgId', 'lastSenderUid']))
            || previewOk(request.resource.data))
        // The icebreaker flag only ever goes from unset to true, and
        // only the person who opened the chat can set it.
        && (!(changedKeys().hasAny(['icebreakerUsed']))
            || (request.resource.data.icebreakerUsed == true
                && resource.data.get('icebreakerUsed', false) == false
                && resource.data.initiatedByUid == uid()))
        // The pair is fixed for the life of the chat.
        && request.resource.data.userUids == resource.data.userUids
        && request.resource.data.initiatedByUid == resource.data.initiatedByUid
        // You may only mark yourself as typing.
        && (!(changedKeys().hasAny(['typingUid']))
            || request.resource.data.typingUid == uid()
            || request.resource.data.typingUid == '')
        && (!(changedKeys().hasAny(['status']))
            || request.resource.data.status in ['unlocked', 'icebreaker'])
        /* The inbox is ordered by lastUpdated, newest first, and
           nothing used to bound it. One write of a number far in the
           future pinned a conversation to the top of the other
           person's inbox for good — the same trick as a message dated
           2099 pinning itself to the top of a thread. It stays a
           CLIENT number rather than becoming request.time, because the
           inbox has to reorder the instant you send rather than after
           a round trip, and a server stamp reads as null until it
           lands. Bounded is enough: it only has to be roughly now. */
        && (!(changedKeys().hasAny(['lastUpdated']))
            || sensibleTime(request.resource.data.lastUpdated));

      // Keeping the thread means the icebreaker state can't be reset by
      // deleting and recreating the chat.
      allow delete: if false;

      match /messages/{messageId} {

        allow read: if inThisChat();

        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        // THE ICEBREAKER, for real this time.
        //
        // The app has always shown one message and then locked the box
        // until the other person replied — but only in the client, so
        // anybody willing to open the console could send a hundred. For
        // an app where a stranger can message any student by handle,
        // that is the thing most worth getting right.
        //
        // Now the single opening message must flip `icebreakerUsed` on
        // the chat in the same batch, and the flag can never go back.
        // There is exactly one such write, ever. The other person is
        // never limited — replying is what unlocks the thread.
        function icebreakerAllowed() {
          return chat().status != 'icebreaker'
              || chat().initiatedByUid != uid()
              || (chat().get('icebreakerUsed', false) == false
                  && chatAfter().icebreakerUsed == true);
        }

        // The chat id IS the block key for a direct chat, so this is a
        // single cheap existence check.
        allow create: if inThisChat()
          && !exists(/databases/$(database)/documents/blocks/$(chatId))
          && request.resource.data.senderUid == uid()
          && isString(request.resource.data.text, 2000)
          && sensibleTime(request.resource.data.time)
          && icebreakerAllowed();

        // Same shapes as the event chat. Note there is no block check
        // on the rewrite: taking back or fixing something you already
        // sent stays possible after one of you blocks the other, which
        // is the right way round — being blocked should not pin your
        // own words in somebody's thread. Reacting is different: that
        // is speaking to them, so it is blocked like any other write.
        allow update: if (inThisChat() && senderMayRewrite())
          || (inThisChat()
              && !exists(/databases/$(database)/documents/blocks/$(chatId))
              && isReactionToggle());

        // Retraction is an update now, so the only delete left is a
        // hard one, and nothing in the app asks for it.
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // BLOCKS  —  blocks/{uidA_uidB}
    //
    // One document per pair, regardless of who blocked whom, so a block
    // is symmetrical by construction: neither side can reach the other
    // and neither can be "half unblocked". Only the person who created
    // it can lift it.
    // ---------------------------------------------------------------
    match /blocks/{pairId} {

      function inPair() {
        return signedIn() && uid() in pairId.split('_');
      }

      // get by id (works before it exists); list mirrors the client's
      // own query, `where pair array-contains uid`, so Firestore can
      // verify it upfront.
      allow get: if inPair();
      allow list: if signedIn() && uid() in resource.data.pair;

      allow create: if inPair()
        && request.resource.data.createdAt == request.time
        && request.resource.data.pair.size() == 2
        && uid() in request.resource.data.pair
        && request.resource.data.pair[0] < request.resource.data.pair[1]
        && pairId == request.resource.data.pair[0] + '_' + request.resource.data.pair[1]
        && request.resource.data.blockerUid == uid();

      // A block is not editable — lift it and make a new one.
      allow update: if false;

      // Only the blocker can unblock. The blocked person must not be
      // able to clear it themselves.
      allow delete: if signedIn() && resource.data.blockerUid == uid();
    }

    // ---------------------------------------------------------------
    // ORBIT  —  orbit/{uidA_uidB}
    //
    // A connection between two people, stored the same way as a block
    // or a direct chat: one document, id = the two uids sorted and
    // joined. `fromUid` records who asked and `status` is 'pending'
    // until the OTHER person accepts, so a single document carries both
    // the request and the connection and the two can never disagree.
    //
    // One document per pair also means one query — `pair array-contains
    // me` — returns your whole orbit and every request waiting on you,
    // in one listener.
    // ---------------------------------------------------------------
    match /orbit/{pairId} {

      function inPair() {
        return signedIn() && uid() in pairId.split('_');
      }

      function theOther() {
        return pairId.split('_')[0] == uid()
          ? pairId.split('_')[1]
          : pairId.split('_')[0];
      }

      // get by id answers "have I already asked?" before the document
      // exists; list mirrors the client's own query so Firestore can
      // verify it without reading anything.
      allow get: if inPair();
      allow list: if signedIn() && uid() in resource.data.pair;

      allow create: if inPair()
        && request.resource.data.keys().hasOnly(['pair', 'fromUid', 'status', 'at'])
        && request.resource.data.pair.size() == 2
        && request.resource.data.pair[0] < request.resource.data.pair[1]
        && pairId == request.resource.data.pair[0] + '_' + request.resource.data.pair[1]
        && uid() in request.resource.data.pair
        // You send your own requests. Nobody opens one on your behalf.
        && request.resource.data.fromUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && !blockedWith(theOther())
        // Orbit comes after following. You can only ask someone you are
        // actually in the followers of — checked on THEIR document, which
        // only they and their followers can change, not on your own
        // `following`, which you could write anything into.
        && exists(followerPath(theOther(), uid()))
        // Same three-second gate as asking to follow, off the same
        // ledger — one person cannot paper the campus in requests.
        && stampedAsk()
        && lastAskAt() < request.time - duration.value(3, 's');

      // Accepting is the only edit, it only goes one way, and only the
      // person who RECEIVED the request can do it.
      allow update: if inPair()
        && resource.data.status == 'pending'
        && resource.data.fromUid != uid()
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'linked';

      // Withdraw, decline, or leave someone's orbit — all the same
      // delete, available to either side at any point.
      allow delete: if inPair();
    }

    // ---------------------------------------------------------------
    // REPORTS  —  write-only drop box
    //
    // Students can file; nobody can read, edit or delete from the
    // client. Read them in the Firebase console.
    // ---------------------------------------------------------------
    /* The circles themselves: a name and a point, readable by anyone
       signed in and written by nobody from the client. They are made in
       the console, and the app works with no circle document at all —
       everything on one is either a display name or the position that
       events copy. */
    match /circles/{circleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        // Nobody reads a report from the client, so there is no
        // optimistic paint to protect: this can simply be the truth.
        // Triage will want them in the order they really arrived.
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------
    // DEFAULT DENY
    // Anything not matched above is refused. Never remove this.
    // ---------------------------------------------------------------
    // ---------------------------------------------------------------
    // ACTIVE NOW — presence/{uid}
    // ---------------------------------------------------------------
    // One small document per person: { visible: true, at: now } while
    // they are in the app, or { visible: false } and NOTHING ELSE when
    // they have turned "Show when you're active" off. That shape is the
    // privacy guarantee: a hidden person's document holds no time, so
    // there is nothing for anybody to read. `at` can only ever say
    // "now" (request.time), so nobody can look active on a schedule.
    //
    // Read by any signed-in person, one document at a time (no list),
    // and only by the app for people already on your screen. "Turn
    // mine off and you won't see theirs" is the app's side of the deal:
    // enforcing it here would read your own presence document inside
    // every lookup, doubling what presence costs. See docs/data.md.
    match /presence/{personUid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && personUid == uid()
        && request.resource.data.visible is bool
        && ((request.resource.data.visible == true
              && request.resource.data.keys().hasOnly(['visible', 'at'])
              && request.resource.data.at == request.time)
            || (request.resource.data.visible == false
              && request.resource.data.keys().hasOnly(['visible'])));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
